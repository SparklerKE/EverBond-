<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#102c27">
<meta name="description" content="EverBond International — personal matchmaking and relationship services connecting genuine hearts in Kenya and worldwide.">
<title>EverBond International | Where Genuine Hearts Connect</title>

<style>
:root {
  --green: #102c27;
  --green-light: #1d4037;
  --gold: #d6b36b;
  --cream: #fbf8f1;
  --white: #ffffff;
  --text: #27342e;
  --muted: #6b766e;
  --border: #e7dfd0;
  --radius: 20px;
  --shadow: 0 12px 35px rgba(16,44,39,.09);
}

* { box-sizing: border-box; }

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  background: var(--cream);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.7;
}

img { max-width: 100%; display: block; }
a { text-decoration: none; color: inherit; }
button, input, textarea, select { font: inherit; }

.container {
  width: min(1150px, 92%);
  margin: auto;
}

.topbar {
  background: var(--green);
  color: white;
  text-align: center;
  padding: 8px;
  font-size: 13px;
  letter-spacing: .5px;
}

header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(251,248,241,.97);
  border-bottom: 1px solid var(--border);
}

nav {
  min-height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--green);
  min-width: 0;
}

.logo-icon {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: var(--green);
  color: var(--gold);
  border: 1px solid var(--gold);
  display: grid;
  place-items: center;
  font-size: 26px;
  flex-shrink: 0;
}

.logo-name {
  font-family: Georgia, serif;
  font-size: 21px;
  font-weight: bold;
  line-height: 1.2;
}

.logo-sub {
  font-size: 10px;
  letter-spacing: 1.4px;
  text-transform: uppercase;
  color: var(--muted);
}

.navlinks {
  display: flex;
  align-items: center;
  gap: 22px;
  font-size: 14px;
}

.navlinks a:hover { color: #99742e; }

.menu-btn {
  display: none;
  border: 1px solid var(--border);
  background: white;
  padding: 9px 13px;
  border-radius: 10px;
  cursor: pointer;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid transparent;
  border-radius: 50px;
  padding: 13px 21px;
  font-weight: bold;
  cursor: pointer;
  transition: .2s;
}

.btn:hover { transform: translateY(-2px); }

.btn-primary {
  background: var(--green);
  color: white;
}

.btn-primary:hover { background: var(--green-light); }

.btn-outline {
  border-color: #bcae92;
  color: var(--green);
  background: transparent;
}

.hero {
  padding: 75px 0;
  background:
    radial-gradient(circle at 85% 20%, #e9dfc8 0, transparent 28%),
    linear-gradient(120deg, #fbf8f1, #f3eddf);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  align-items: center;
  gap: 55px;
}

.eyebrow {
  color: #99742e;
  text-transform: uppercase;
  font-size: 12px;
  letter-spacing: 2px;
  font-weight: bold;
}

h1, h2, h3 {
  font-family: Georgia, "Times New Roman", serif;
  color: var(--green);
  line-height: 1.2;
}

h1 {
  font-size: clamp(42px, 5.5vw, 72px);
  letter-spacing: -2px;
  margin: 18px 0;
}

h1 em {
  color: #a78039;
  font-weight: normal;
}

.hero p {
  color: var(--muted);
  font-size: 17px;
}

.hero-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin: 27px 0;
}

.trust {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
  font-size: 12px;
  color: #526157;
}

.hero-image {
  min-height: 430px;
  border-radius: 180px 180px 22px 22px;
  background: linear-gradient(145deg,#e9d9b8,#c7d5c8);
  border: 6px solid white;
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
  position: relative;
}

.hero-image img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-placeholder {
  padding: 30px;
  color: var(--green);
}

.image-placeholder .heart {
  font-size: 75px;
  color: #a78039;
}

.image-placeholder h2 {
  font-size: 26px;
}

.image-editor {
  margin-top: 15px;
  font-size: 12px;
}

.section { padding: 80px 0; }
.section-white { background: white; }
.section-green { background: var(--green); color: white; }

.section-green h2,
.section-green h3 { color: #fff6e5; }

.heading {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 40px;
}

.heading h2 {
  font-size: clamp(30px, 4vw, 45px);
  margin: 12px 0;
}

.heading p { color: var(--muted); }

.section-green .heading p { color: #d6dfd8; }

.cards {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 20px;
}

.card {
  background: white;
  padding: 28px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: 0 5px 20px rgba(0,0,0,.025);
}

.card-icon {
  width: 50px;
  height: 50px;
  background: #f3ebda;
  color: #94702e;
  border-radius: 15px;
  display: grid;
  place-items: center;
  font-size: 25px;
  margin-bottom: 18px;
}

.card h3 { font-size: 23px; margin: 0 0 10px; }
.card p { color: var(--muted); margin: 0; }

.steps {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 16px;
}

.step {
  border-top: 2px solid var(--gold);
  background: rgba(255,255,255,.06);
  padding: 23px;
  border-radius: 0 0 15px 15px;
}

.step-number {
  color: var(--gold);
  font-weight: bold;
  font-size: 12px;
  letter-spacing: 1px;
}

.step h3 { font-size: 22px; margin: 14px 0 8px; }
.step p { color: #d4ddd6; font-size: 14px; }

.two-column {
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  gap: 35px;
  align-items: start;
}

.info-panel {
  background: #f1e9d9;
  border-radius: var(--radius);
  padding: 28px;
  margin-top: 25px;
}

.info-panel h3 { font-size: 25px; margin-top: 0; }
.info-panel p { color: var(--muted); }

.form-card {
  background: white;
  padding: 30px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.form-card h3 { font-size: 30px; margin-top: 0; }
.form-card > p { color: var(--muted); font-size: 14px; }

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.field.full { grid-column: 1 / -1; }

label {
  font-size: 13px;
  font-weight: bold;
  color: var(--text);
}

input, select, textarea {
  width: 100%;
  border: 1px solid #d9d8cf;
  border-radius: 11px;
  padding: 12px;
  background: #fffdf9;
  color: var(--text);
}

input:focus, select:focus, textarea:focus {
  outline: 2px solid #d6b36b;
  outline-offset: 1px;
}

textarea { min-height: 110px; resize: vertical; }

.consent {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 10px;
  font-size: 12px;
  font-weight: normal;
}

.consent input {
  width: auto;
  margin-top: 5px;
}

.form-note {
  font-size: 12px;
  color: var(--muted);
}

.contact-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 18px;
}

.contact-card {
  padding: 25px;
  border: 1px solid rgba(255,255,255,.15);
  background: rgba(255,255,255,.06);
  border-radius: var(--radius);
}

.contact-card h3 { font-size: 23px; }
.contact-card p { color: #d4ddd6; font-size: 14px; }
.contact-card a { color: var(--gold); font-weight: bold; overflow-wrap: anywhere; }

.faq { max-width: 820px; margin: auto; }

details { border-bottom: 1px solid var(--border); padding: 19px 0; }

summary {
  cursor: pointer;
  font-weight: bold;
  color: var(--green);
}

details p { color: var(--muted); }

footer {
  background: #0b211d;
  color: white;
  padding: 45px 0 25px;
}

footer p { color: #cbd5ce; font-size: 14px; }
.footer-bottom {
  border-top: 1px solid #ffffff25;
  margin-top: 25px;
  padding-top: 20px;
  font-size: 12px;
  color: #cbd5ce;
}

.whatsapp-float {
  position: fixed;
  right: 18px;
  bottom: 18px;
  z-index: 200;
  padding: 13px 18px;
  background: #16834c;
  color: white;
  border-radius: 50px;
  font-weight: bold;
  box-shadow: var(--shadow);
}

#photoInput { display: none; }

@media(max-width:900px) {
  .hero-grid, .two-column { grid-template-columns: 1fr; }
  .hero-image { min-height: 370px; max-width: 600px; width: 100%; margin: auto; }
  .cards { grid-template-columns: 1fr 1fr; }
  .steps { grid-template-columns: 1fr 1fr; }
  .contact-grid { grid-template-columns: 1fr; }
}

@media(max-width:650px) {
  nav { min-height: 70px; }
  .logo-name { font-size: 17px; }
  .logo-sub { font-size: 8px; letter-spacing: 1px; }
  .logo-icon { width: 40px; height: 40px; }
  .menu-btn { display: block; }
  .navlinks {
    display: none;
    position: absolute;
    top: 70px;
    left: 0;
    right: 0;
    background: var(--cream);
    padding: 20px;
    flex-direction: column;
    align-items: stretch;
    border-bottom: 1px solid var(--border);
  }
  .navlinks.open { display: flex; }
  .hero { padding: 48px 0; }
  .hero-image { min-height: 320px; border-radius: 130px 130px 20px 20px; }
  .section { padding: 58px 0; }
  .cards, .steps, .form-grid { grid-template-columns: 1fr; }
  .field.full { grid-column: auto; }
  .form-card { padding: 22px; }
  .whatsapp-float { right: 10px; bottom: 10px; }
}
</style>
</head>

<body>

<div class="topbar">
  Personal Matchmaking · Kenya & International Connections · Adults 18+
</div>

<header>
  <nav class="container">
    <a class="logo" href="#home">
      <span class="logo-icon">♡</span>
      <span>
        <span class="logo-name">EverBond International</span><br>
        <span class="logo-sub">Matchmaking & Relationship Services</span>
      </span>
    </a>

    <button class="menu-btn" id="menuBtn" aria-expanded="false">☰ Menu</button>

    <div class="navlinks" id="navlinks">
      <a href="#about">About</a>
      <a href="#process">How It Works</a>
      <a href="#join">Join Us</a>
      <a href="#contact">Contact</a>
      <a class="btn btn-primary" href="#join">Start Your Journey ↗</a>
    </div>
  </nav>
</header>

<main>

<section class="hero" id="home">
  <div class="container hero-grid">
    <div>
      <span class="eyebrow">A more thoughtful way to meet</span>

      <h1>Where <em>Genuine Hearts</em> Connect.</h1>

      <p>
        Meaningful relationships begin with being seen, heard, and understood.
        EverBond International helps relationship-minded singles explore
        compatible introductions in Kenya and beyond—with care, discretion,
        and respect.
      </p>

      <div class="hero-actions">
        <a href="#join" class="btn btn-primary">Begin Your Introduction →</a>
        <a href="#process" class="btn btn-outline">Discover Our Process</a>
      </div>

      <div class="trust">
        <span>♡ Personal Attention</span>
        <span>✧ Consent-Led Introductions</span>
        <span>✓ Privacy-Minded Service</span>
      </div>
    </div>

    <div>
      <div class="hero-image" id="heroImage">
        <div class="image-placeholder">
          <div class="heart">♡</div>
          <h2>Your Story.<br>Your Next Chapter.</h2>
          <p>Add your own marketing photo using the button below.</p>
        </div>
      </div>
      <div class="image-editor">
        <button class="btn btn-outline" id="editImage">＋ Add Marketing Picture</button>
        <button class="btn btn-outline" id="resetImage">Reset Image</button>
        <input type="file" id="photoInput" accept="image/*">
      </div>
    </div>
  </div>
</section>

<section class="section section-white" id="about">
  <div class="container">
    <div class="heading">
      <span class="eyebrow">Our Philosophy</span>
      <h2>Not Just a Match.<br>A Meaningful Beginning.</h2>
      <p>
        We believe the right introduction starts with honest conversations,
        clear expectations, and respect for every person's journey.
      </p>
    </div>

    <div class="cards">
      <article class="card">
        <div class="card-icon">♡</div>
        <h3>People Before Profiles</h3>
        <p>
          Share the values, hopes, and qualities that matter to you—not just
          a checklist.
        </p>
      </article>

      <article class="card">
        <div class="card-icon">✧</div>
        <h3>Intentional Introductions</h3>
        <p>
          We aim to understand relationship goals and compatibility before
          proposing an introduction. Matches are not guaranteed.
        </p>
      </article>

      <article class="card">
        <div class="card-icon">✓</div>
        <h3>Respect and Discretion</h3>
        <p>
          Your information should be handled carefully and shared with a
          potential match only with your permission.
        </p>
      </article>
    </div>
  </div>
</section>

<section class="section section-green" id="process">
  <div class="container">
    <div class="heading">
      <span class="eyebrow">Simple, Personal, Transparent</span>
      <h2>A Clear Path to Connection.</h2>
      <p>
        Every introduction begins with understanding what you are looking for
        and what you feel comfortable sharing.
      </p>
    </div>

    <div class="steps">
      <article class="step">
        <span class="step-number">STEP 01</span>
        <h3>Tell Us About You</h3>
        <p>Share a brief profile, your relationship goals, and the qualities you value.</p>
      </article>

      <article class="step">
        <span class="step-number">STEP 02</span>
        <h3>Have a Conversation</h3>
        <p>We explain our process, answer questions, and discuss applicable fees.</p>
      </article>

      <article class="step">
        <span class="step-number">STEP 03</span>
        <h3>Explore Compatibility</h3>
        <p>When a suitable opportunity arises, we discuss a possible introduction with both people.</p>
      </article>

      <article class="step">
        <span class="step-number">STEP 04</span>
        <h3>Choose Your Next Step</h3>
        <p>Proceed only when both people consent. You remain in control of your decisions.</p>
      </article>
    </div>
  </div>
</section>

<section class="section" id="join">
  <div class="container two-column">

    <div>
      <span class="eyebrow">Your Next Chapter Starts Here</span>
      <h2 style="font-size:42px">Start With a Simple Introduction.</h2>
      <p style="color:var(--muted)">
        Tell us a little about yourself. You decide what to share and can ask
        questions before committing to a service.
      </p>

      <div class="info-panel">
        <h3>What Happens Next?</h3>
        <p>
          We will review your enquiry and contact you to discuss your goals,
          our process, and any applicable fees before proceeding.
        </p>
        <p>✓ No public profile is created from this form.</p>
        <p>✓ No guaranteed match or relationship outcome.</p>
        <p>✓ Do not submit identity documents or financial information here.</p>
      </div>
    </div>

    <div class="form-card">
      <h3>Client Introduction Form</h3>
      <p>
        Complete the form, then choose email or WhatsApp. Your device will
        prepare a message for you to review and send.
      </p>

      <form id="profileForm">
        <div class="form-grid">

          <div class="field">
            <label for="fullName">Name *</label>
            <input id="fullName" required maxlength="100" autocomplete="name"
              placeholder="Your name">
          </div>

          <div class="field">
            <label for="age">Age *</label>
            <input id="age" type="number" min="18" max="110" required
              placeholder="18 or older">
          </div>

          <div class="field">
            <label for="gender">Gender (optional)</label>
            <select id="gender">
              <option value="">Prefer not to say</option>
              <option>Woman</option>
              <option>Man</option>
              <option>Non-binary</option>
              <option>Prefer to explain privately</option>
            </select>
          </div>

          <div class="field">
            <label for="country">Country of Residence *</label>
            <input id="country" required maxlength="80"
              placeholder="e.g. Kenya">
          </div>

          <div class="field">
            <label for="email">Email Address *</label>
            <input id="email" type="email" required maxlength="150"
              autocomplete="email" placeholder="you@example.com">
          </div>

          <div class="field">
            <label for="phone">WhatsApp / Phone</label>
            <input id="phone" type="tel" maxlength="30"
              placeholder="Include country code">
          </div>

          <div class="field">
            <label for="goal">Relationship Goal *</label>
            <select id="goal" required>
              <option value="">Choose one</option>
              <option>Serious relationship</option>
              <option>Marriage-minded matchmaking</option>
              <option>Open to getting to know someone</option>
              <option>Would like guidance</option>
            </select>
          </div>

          <div class="field">
            <label for="location">Preferred Match Location</label>
            <select id="location">
              <option>Kenya</option>
              <option>Africa</option>
              <option>Europe</option>
              <option>North America</option>
              <option>Middle East</option>
              <option>Anywhere / international</option>
              <option>Other</option>
            </select>
          </div>

          <div class="field full">
            <label for="qualities">Qualities You Value *</label>
            <textarea id="qualities" required maxlength="1200"
              placeholder="For example: honesty, kindness, loyalty, communication..."></textarea>
          </div>

          <div class="field full">
            <label for="aboutYou">Brief Introduction About Yourself</label>
            <textarea id="aboutYou" maxlength="1200"
              placeholder="Share your interests, values, and lifestyle if comfortable."></textarea>
          </div>

          <div class="field full">
            <label class="consent">
              <input type="checkbox" id="consent" required>
              <span>
                I confirm that I am 18 or older and am voluntarily submitting
                this enquiry. I understand my information will be included
                in a draft message that I can review before sending. *
              </span>
            </label>
          </div>

          <div class="field full">
            <button class="btn btn-primary" type="submit">
              Continue to WhatsApp →
            </button>
            <p class="form-note">
              This is an enquiry, not automatic enrolment in a paid service.
              Review your message before sending.
            </p>
          </div>
        </div>
      </form>

      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:15px">
        <button class="btn btn-outline" type="button" id="emailButton">
          Send by Email
        </button>
        <button class="btn btn-outline" type="button" id="whatsappButton">
          Send by WhatsApp
        </button>
      </div>
    </div>
  </div>
</section>

<section class="section section-green" id="contact">
  <div class="container">
    <div class="heading">
      <span class="eyebrow">We Are Here to Help</span>
      <h2>Start a Conversation With Us.</h2>
      <p>
        Questions about our process, fees, or whether matchmaking is right for
        you? Contact us directly.
      </p>
    </div>

    <div class="contact-grid">
      <article class="contact-card">
        <div class="card-icon">✉</div>
        <h3>Email Us</h3>
        <p>For enquiries and service information.</p>
        <a href="mailto:ever
